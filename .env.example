# ============================================================
# Firefly Character AI Assistant — Environment Configuration
# ============================================================
# Copy this file to .env and customize:
#   cp .env.example .env
#
# All variables have sensible defaults; only set what you need to override.

# --- Model Paths ---
# FIREFLY_MODEL_PATH=./model                  # Base model directory
# FIREFLY_LORA_PATH=./output/Firefly_LoRA     # SFT LoRA adapter
# FIREFLY_DPO_MERGED_PATH=./output/Firefly_DPO_Merged  # DPO merged model (recommended)

# --- RAG Database ---
# FIREFLY_RAG_DB_PATH=./chroma_db            # ChromaDB vector database

# --- Data & Logs ---
# FIREFLY_DATA_DIR=./data                     # Training data directory
# FIREFLY_LOG_DIR=./logs                      # Log output directory

# --- Server ---
# FIREFLY_HOST=0.0.0.0
# FIREFLY_PORT=7860

# --- Inference ---
# FIREFLY_MAX_TOKENS=512
# FIREFLY_TEMPERATURE=0.7
# FIREFLY_TOP_P=0.9
# FIREFLY_TOP_K=50
# FIREFLY_REPETITION_PENALTY=1.1

# --- Feature Toggles ---
# FIREFLY_ENABLE_RAG=true
# FIREFLY_ENABLE_VALIDATION=true
# FIREFLY_ENABLE_RATE_LIMIT=false             # Rate limiting (requires slowapi)

# --- vLLM (optional, for production inference) ---
# FIREFLY_VLLM_URL=http://localhost:8000       # vLLM server URL

# --- Training Defaults ---
# FIREFLY_LORA_R=32
# FIREFLY_LORA_ALPHA=64
# FIREFLY_EPOCHS=8
# FIREFLY_LR=3e-5
